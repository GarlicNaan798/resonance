# ---------------------------------------------------------------------------
# Resonance — credential template.
# Copy to `.env` and fill in. NEVER commit `.env` (it is gitignored).
# Every key is optional; the pipeline skips sources whose token is absent.
# ---------------------------------------------------------------------------

# HuggingFace — read token for gated datasets (e.g. PeterBrendan/AdImageNet).
# Get one: https://huggingface.co/settings/tokens  ->  "Create new token" -> type: Read
# You must ALSO click "Agree and access repository" on each gated dataset page.
HF_TOKEN=

# Meta Ad Library — ads_archive scope. Requires government-ID verification first.
# https://www.facebook.com/ads/library/api/
META_ACCESS_TOKEN=

# YouTube Data API v3 key (Google Cloud console, free tier).
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Optional: contact string sent in the User-Agent when crawling public archives.
# Being identifiable is good crawler manners.
CRAWLER_CONTACT=
