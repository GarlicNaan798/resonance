# Secrets — never commit
.env
.env.local
.env.*.local
*.pem
*.key

# Data: large, redistributable only under each source's own licence
data/raw/
data/interim/
# Contents, not the directory itself: git cannot re-include a file whose parent
# directory is excluded, and the two exceptions below have to be committable.
data/processed/*

# The test lock and the read log are evidence, not derived artefacts. A
# fingerprint nobody else can see protects nothing, and a read log that starts
# empty on every clone defeats its own purpose.
!data/processed/upworthy_test.lock.json
!data/processed/test_reads.jsonl
!data/processed/model_card.md

*.parquet
*.jsonl.part

# Derived splits: regenerable from pipeline/splits.py, and 5 MB of corpus text
# we have no licence to redistribute. The test-set LOCK file IS tracked, because
# it is the fingerprint that proves the test set never changed.
data/splits/*.jsonl
!data/splits/test.lock.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Node / Next.js
node_modules/
.next/
out/
build/
dist/

# Model artefacts (weights are exported deliberately, not scooped up by accident)
*.pt
*.ckpt

# OS
.DS_Store
Thumbs.db

# memsearch runtime state (PID + index cursor). The memory/ notes are kept.
.memsearch/.index.pid
.memsearch/.index-state.json
.resonance/

# Obsidian editor state. workspace.json records open panes and rewrites
# constantly, so committing it produces diff noise and merge conflicts that
# say nothing about the project.
.obsidian/

# Unrelated download that was sitting in the repo root.
andrej-karpathy-skills-main.zip
